{
  "id": "agenda.marcar-consulta",
  "profile": "rececao",
  "sizes": ["390", "desktop"],
  "stabilize": ["[data-testid=\"agenda-freshness\"] time"],
  "frames": [
    {
      "goto": "/agenda?date=2026-10-06",
      "ready": { "role": "button", "nameKey": "agenda.newAppointment" },
      "annotate": [
        { "kind": "arrow", "n": 1, "target": { "role": "button", "nameKey": "agenda.newAppointment" }, "from": { "390": "below", "desktop": "below-left" } }
      ]
    },
    {
      "do": [{ "click": { "role": "button", "nameKey": "agenda.newAppointment" } }],
      "ready": { "role": "dialog", "nameKey": "appointment.newTitle" },
      "annotate": [
        { "kind": "box", "n": 2, "target": { "css": "div:has(> label[for=\"appt-patient\"])" } }
      ]
    }
  ]
}
