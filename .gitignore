# DB-gated RLS gate artifacts (generated by the vitest json reporter in db-tests.yml)
packages/db/rls-results.json
packages/db/rls-run.log

# OS
Thumbs.db

# Supabase — local runtime state only; keep migrations/ and config.toml tracked
supabase/.branches/
supabase/.temp/
.vercel

# Monorepo build artifacts
.turbo/
dist/
*.tsbuildinfo

*storybook.log
storybook-static

# local agent tooling (worktrees, usage tracker) — never commit
.claude/worktrees/
.worktrees/
claude-usage/

# Pre-Launch Board rendered artifact (generated by docs/board/render-board.mjs)
docs/board/prelaunch-board.rendered.html

# Portal Board rendered artifact (generated by docs/board/render-board.mjs)
docs/board/portal-board.rendered.html

# W13-01a: apps/web DB-gated vitest report + log (build products, like packages/db's)
apps/web/web-db-results.json
apps/web/web-db-run.log

# Fisiozero import - the FILLED mapping config. The template beside it is
# committed; this one carries live tenant uuids for staff and services and has
# no reason to be in a public history.
scripts/import/mapping-config.local.json
**/mapping-config.local.json

# Fisiozero extractor - session credentials and plaintext archives
fz-state.json
**/fz-state.json
fisiozero-archive/
**/fisiozero-archive/
*.storageState.json
**/*.storageState.json

# LE-seed-not-idempotent: the id of the AI review draft the seed is currently
# offering. Written by seed-e2e.mjs, read by e2e/fixtures.ts; per-machine state,
# never source.
apps/web/e2e/seed/seed-state.json

# LE-local-supabase-per-lane: generated per-lane Supabase projects
# (scripts/lane-stack.mjs). Config is RENDERED from supabase/config.toml and the
# migrations are symlinks to it, so nothing here is source.
.lane/
