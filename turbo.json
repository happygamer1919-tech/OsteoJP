{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": [
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY",
        "SUPABASE_URL",
        "SUPABASE_SERVICE_ROLE_KEY",
        "SUPABASE_JWT_SECRET",
        "DATABASE_URL",
        "NEXT_PUBLIC_API_URL",
        "PATIENT_SESSION_SECRET",
        "E2E_ADMIN_EMAIL",
        "E2E_ADMIN_PASSWORD",
        "E2E_THERAPIST_EMAIL",
        "E2E_THERAPIST_PASSWORD",
        "E2E_RECEPTION_EMAIL",
        "E2E_RECEPTION_PASSWORD",
        "E2E_PORTAL_PATIENT_EMAIL",
        "E2E_PORTAL_PATIENT_PASSWORD",
        "CI",
        "PWDEBUG",
        "PLAYWRIGHT_*"
      ]
    }
  }
}