# Supabase — same project as apps/web, patient role JWT
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Platform API (apps/api) base URL
# Local dev: http://localhost:3002
# Staging: https://api-dev.osteojp.pt
# Production: https://api.osteojp.pt
NEXT_PUBLIC_API_URL=https://api.osteojp.pt

# App URL — THE PORTAL IS NOT ON ITS CUSTOM DOMAIN YET.
#
# `patient.osteojp.pt` DOES NOT RESOLVE. Its CNAME is still PENDING
# (docs/dns-records-pending.md:27, :89) and the Vercel project shows "Invalid
# Configuration" until that record exists. This file named it until 2026-08-12,
# and taking it at face value points a running portal at a dead hostname — which
# is the single most likely way to lose the first ten minutes of a sitting, and
# worse in front of the clinic team.
#
# THE LIVE HOST IS THE VERCEL DEFAULT. docs/SPEC.md:55: project `osteojp-portal`,
# "live at osteojp-portal.vercel.app. Custom domain patient.osteojp.pt deferred
# to go-live."
#
# AT GO-LIVE: add the CNAME per docs/dns-records-pending.md, confirm Vercel reads
# "Valid Configuration", THEN change the line below to
# https://patient.osteojp.pt. The cutover checklist is docs/cutover-runbook.md.
#
# NOTE the staff platform is DIFFERENT and IS on its custom domain
# (app.osteojp.pt, live). Do not assume the two hosts follow the same pattern.
NEXT_PUBLIC_APP_URL=https://osteojp-portal.vercel.app
