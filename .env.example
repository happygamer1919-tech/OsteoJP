# ---------------------------------------------------------------------------
# Public — safe to expose to the browser (Next.js NEXT_PUBLIC_* convention)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Server-only — never expose these to the client or commit real values
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
# Supabase SESSION pooler (...pooler.supabase.com:5432) for drizzle-kit migrate (transaction pooler does not support session advisory locks). Not the db.<ref>.supabase.co direct host (IPv4-gated).
DATABASE_URL_DIRECT=

# ---------------------------------------------------------------------------
# Sentry — error monitoring (apps/web). EU region project.
# ---------------------------------------------------------------------------
# Public DSN used by the browser SDK (instrumentation-client.ts).
NEXT_PUBLIC_SENTRY_DSN=
# Server/edge DSN used by sentry.server.config.ts and sentry.edge.config.ts.
SENTRY_DSN=
# Auth token for source-map upload during `next build` (CI only, do not commit).
SENTRY_AUTH_TOKEN=
# Sentry organization slug (e.g. osteojp).
SENTRY_ORG=
# Sentry project slug (e.g. web).
SENTRY_PROJECT=

# ---------------------------------------------------------------------------
# Reminders (Stream E) — appointment reminder jobs. SANDBOX by default.
# ---------------------------------------------------------------------------
# Master switch for LIVE sends. Sandbox unless set to exactly "true": reminders
# render and log but make ZERO network calls. Flip to "true" only in prod after
# the Resend domain and Twilio sender are verified.
REMINDERS_LIVE_SEND=
# Base URL for the reschedule short-link in reminder EMAIL copy. The link resolves
# at <base>/r/<token>. Defaults to https://osteojp.pt.
REMINDERS_RESCHEDULE_BASE_URL=
# Secret for HMAC-signing the stateless reschedule short-link token (/r/<token>).
# Required to mint links; signing fails loud if unset. Use a long random value
# (e.g. `openssl rand -base64 32`). Server-only — NEVER expose or log it.
REMINDERS_LINK_SECRET=

# ---------------------------------------------------------------------------
# Staff invite / password recovery landing (apps/web)
# ---------------------------------------------------------------------------
# Where Supabase sends a staff member AFTER it verifies their recovery link.
# Read at apps/web/lib/auth/provision.ts:222 and passed to
# admin.generateLink({ type: "recovery" }) as `redirectTo`.
#
# WHEN UNSET, Supabase falls back to the project's SITE URL. That is a real
# defect on a multi-app project, not a harmless default: this Supabase project
# serves the staff platform, the patient API and the patient portal, and one
# Site URL cannot be correct for all three. A staff recovery on 2026-08-06
# landed on the PATIENT PORTAL for exactly this reason.
#
# Must be an ABSOLUTE url on the STAFF host, and must also be present in the
# Supabase dashboard's redirect allowlist or Supabase refuses the redirect and
# silently falls back to the Site URL again.
#   production: https://app.osteojp.pt/auth/update-password
STAFF_INVITE_REDIRECT_URL=

# ---------------------------------------------------------------------------
# AI ingestion (Stream D) — signed partner endpoint
# /api/v1/ingestion/clinical-records.
# ---------------------------------------------------------------------------
# Shared HMAC secret the AI partner signs each request body with (header
# X-OsteoJP-Signature = HMAC-SHA256 of `${timestamp}.${rawBody}`, plus
# X-OsteoJP-Timestamp). Verification FAILS LOUD if unset — the endpoint will
# 500 rather than accept unverifiable requests. Use a long random value
# (e.g. `openssl rand -base64 32`). This is a LOCAL/DEV value only — the real
# partner secret is provisioned separately, never committed. Server-only.
AI_INGESTION_HMAC_SECRET=local-dev-ingestion-secret-change-me

# Inngest — background job orchestration (apps/web /api/inngest). The local
# Inngest Dev Server needs neither key; both are required in deployed envs.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Resend — transactional email (EU region). Sandbox/test key until the osteojp.pt
# domain is verified. Never commit a real key.
RESEND_API_KEY=
# Verified sender address (pending domain verification).
REMINDERS_EMAIL_FROM=

# Twilio — transactional SMS (PT sender). Test credentials until the alphanumeric
# sender ID is registered for Portugal. Never commit real values.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Either a from-number or a Messaging Service SID (from-number takes precedence).
TWILIO_SMS_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# ---------------------------------------------------------------------------
# InvoiceXpress (Phase 4) — PT fiscal documents (fatura-recibo). OWNER-GATED:
# leave UNSET. With these empty the integration refuses every call before any
# network request. The sandbox key is owner-provisioned and never committed;
# real issuance ALSO needs the VAT-23% sign-off (#107). Server-only.
# ---------------------------------------------------------------------------
# Account subdomain → https://<name>.app.invoicexpress.com
INVOICEXPRESS_ACCOUNT_NAME=
# Secret API key. Never log it, never commit it.
INVOICEXPRESS_API_KEY=

# ---------------------------------------------------------------------------
# Stripe — card payments (PaymentIntent) recorded to the internal invoices
# ledger. OWNER-GATED: leave UNSET. With these empty the integration refuses
# every call before any network request, and the webhook cannot be verified.
# The key is for the clinic's PT entity, owner-provisioned, never committed;
# real charges ALSO need the VAT-23% sign-off (#107). Server-only. EUR only.
# ---------------------------------------------------------------------------
# Secret key (sk_test_… / sk_live_…). Never log it, never commit it.
STRIPE_SECRET_KEY=
# Webhook endpoint signing secret (whsec_…) for inbound signature verification.
STRIPE_WEBHOOK_SECRET=

# ===========================================================================
# ENV-01. THE 44 NAMES THE CODE READS AND THIS FILE DID NOT DOCUMENT.
# ===========================================================================
# Derived by scanning every .ts/.tsx/.mjs outside node_modules for THREE read
# styles, because two of them are invisible to the obvious grep:
#
#   process.env.NAME          the direct read
#   env.NAME                  an INJECTED EnvSource - how OTP_LIVE_SEND is read
#                             (apps/api/lib/auth/otp-transport.ts), which is why
#                             a process.env grep never found it
#   "NAME" as a constant      REMINDERS_REPLY_CAPABLE is declared as
#                             REPLY_CAPABLE_FLAG (reply-capability.ts:56) and
#                             read through it, so it is invisible to BOTH of the
#                             above
#
# The card that opened this said 30 and a dispatch said five. Both were counts
# of what a narrower scan could see. Names only; no value is recorded here.
# ===========================================================================

# --- Message and login gates. Each one decides whether something LEAVES ------
# Gates ALL patient login OTP SMS. Read through an injected EnvSource; when it
# is not exactly "true", resolveOtpTransport returns a NO-OP SINK and reports
# {delivered:false} rather than erroring - so a wrong value fails SILENTLY and
# no patient can log in. Lives on the API project, not the portal.
OTP_LIVE_SEND=
# Gates the staff-invite email, and the address it is sent from.
INVITES_LIVE_SEND=
INVITES_EMAIL_FROM=
# The inbound-reply capability: the webhook, the URL its Twilio signature is
# verified against, and the tenant inbound replies are attributed to.
REMINDERS_INBOUND=
REMINDERS_INBOUND_BASE_URL=
REMINDERS_INBOUND_TENANT_ID=
# Declares that the configured outbound sender can RECEIVE a reply, when the
# code cannot tell: with a messaging service the sender pool is not inspectable,
# so this is asserted rather than guessed. Exactly "true" arms the reply line in
# the 24h SMS. It cannot override a sender the code CAN read.
REMINDERS_REPLY_CAPABLE=
# Appends the late-cancellation fee sentence to the reminder body.
REMINDERS_FEE_NOTICE_ENABLED=
# Appends JP's confirm line to the 24h SMS: `Confirmar: osteojp.pt/c/XXXXXXXX`.
# Exactly "true" arms it; every near-miss ("TRUE", "1", "yes") leaves it OFF.
# IT NEEDS THE SECRET BELOW AS WELL, and the two are checked as one answer:
# armed without a key there is nothing to mint a code with, and every patient
# would receive a broken link.
REMINDERS_CONFIRM_LINK_ENABLED=
# HMAC key for the 8-character confirm code. The table stores a KEYED digest,
# never the code and never a bare sha256: 8 base64url characters is 48 bits, and
# a bare sha256 of 48 bits is exhaustible offline by anyone who obtains a copy
# of appointment_confirm_codes. Issuance THROWS when this is unset rather than
# falling back to an unkeyed digest. Use a long random value
# (e.g. `openssl rand -base64 32`). Server-only - NEVER expose or log it.
REMINDERS_CONFIRM_CODE_SECRET=

# --- Portal and API identity ------------------------------------------------
# The tenant the patient portal serves, and the API origin the portal calls.
PORTAL_TENANT_ID=
NEXT_PUBLIC_API_URL=
# Signs the patient portal session. Server-only, never exposed to a browser.
PATIENT_SESSION_SECRET=
# Verifies Supabase-issued JWTs in apps/api. Server-only.
SUPABASE_JWT_SECRET=
# The Supabase project URL. Read by the e2e seeder and by assert-not-prod.ts,
# which checks it BESIDE the database URL - a shell whose DATABASE_URL points at
# a scratch project while this still points at production would pass a
# database-only guard and then write to the live bucket.
SUPABASE_URL=
# Comma-separated operator addresses for the admin app.
PLATFORM_OPERATOR_EMAILS=

# --- Consultation audio (S3) ------------------------------------------------
AUDIO_S3_BUCKET=
AUDIO_S3_REGION=
AUDIO_S3_ACCESS_KEY_ID=
AUDIO_S3_SECRET_ACCESS_KEY=
# The M1 transcription webhook and its shared key.
M1_WEBHOOK_URL=
M1_WEBHOOK_API_KEY=

# --- ifthenpay (MB / MB WAY) ------------------------------------------------
# OWNER-GATED, same posture as InvoiceXpress and Stripe above: with these unset
# the integration refuses before any network call.
IFTHENPAY_BASE_URL=
IFTHENPAY_MB_KEY=
IFTHENPAY_MBWAY_KEY=
IFTHENPAY_ANTIPHISHING_KEY=

# --- Seeds and local tooling. NONE of these may name a hosted project --------
# PERF-08 (#1092): every seeding and load-test script now identifies an ALLOWED
# LOCAL TARGET positively and refuses everything else, so these only ever hold a
# 127.0.0.1 / localhost target.
# The seed target, preferred over DATABASE_URL by resolveSeedDatabaseUrl.
DATABASE_URL_DEV=
# The confirmation token: the project ref when the URL has one, the HOST
# otherwise. The refusal message always prints the exact value to set.
SEED_DEV_CONFIRM=
# The tenant configuration seeds write into (form templates, permission roles).
SEED_TENANT_ID=

# --- Twilio smoke test, operator-run ----------------------------------------
# scripts/twilio-smoke.mjs only. TWILIO_SMOKE_CONFIRM is the deliberate opt-in;
# TWILIO_SENDER_ID is the alphanumeric sender, which cannot receive a reply.
TWILIO_SENDER_ID=
SMOKE_TO_NUMBER=
TWILIO_SMOKE_CONFIRM=

# --- Fisiozero extractor (tools/fisiozero-extractor) ------------------------
# The legacy-data extractor's knobs. All optional; each has a default in
# tools/fisiozero-extractor/src/config.ts.
FISIOZERO_BASE_URL=
FISIOZERO_STORAGE_STATE=
FISIOZERO_OUT_DIR=
FISIOZERO_CHECKPOINT=
FISIOZERO_START_ID=
FISIOZERO_END_ID=
FISIOZERO_LIMIT=
FISIOZERO_TIMEOUT_MS=
FISIOZERO_RETRIES=
FISIOZERO_BACKOFF_BASE_MS=
FISIOZERO_RATE_MIN_MS=
FISIOZERO_RATE_MAX_MS=

# --- Build and test-harness only, documented so they are not mistaken for
#     runtime configuration -------------------------------------------------
# The origin Playwright drives; scripts/generate-pwa-icons.mjs's sharp binary.
BASE_URL=
SHARP_PATH=

# --- DELIBERATELY NOT DOCUMENTED ABOVE, recorded so the omission is a decision
#     rather than a gap ------------------------------------------------------
# A4_DISABLE_LOCK  is a NEGATIVE-CONTROL switch that disables single-use
#                  enforcement on the OTP claim path. It exists so db-tests.yml
#                  can prove its own concurrency test is not vacuous. It is not
#                  configuration and must never be set in any real environment,
#                  so it is named here and given no line to fill in.
# PORTAL_BASE_URL  is read only by Playwright specs, which set it themselves.
